# ── Banco de dados ────────────────────────────────────────────────────────────
MONGODB_USERNAME="seu_usuario"
MONGODB_PASSWORD="sua_senha"
MONGODB_URI="mongodb+srv://seu_usuario:sua_senha@seu-cluster.mongodb.net"

# ── Sessão ────────────────────────────────────────────────────────────────────
# OBRIGATÓRIO. Nunca reutilize o valor de exemplo abaixo — gere um valor forte e
# único com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque_por_um_valor_aleatorio_gerado_por_voce"

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000

# Defina como "production" no ambiente de deploy (não em desenvolvimento local).
# Isso ativa cookies "secure" (exigem HTTPS) e evita respostas de erro
# detalhadas para o navegador.
NODE_ENV=development

# URL pública do site, usada para montar os links dos e-mails (verificação de
# conta e redefinição de senha). Em produção, use a URL real do Render, ex.:
# https://seu-servico.onrender.com
APP_URL=http://localhost:3000

# ── E-mail (Resend) ───────────────────────────────────────────────────────────
# [DESATIVADO] A integração com o Resend foi retirada do código porque não
# temos domínio próprio — sem um domínio verificado no painel do Resend, não é
# possível enviar e-mails para outras pessoas. As variáveis abaixo foram
# mantidas documentadas para facilitar a reativação no futuro, quando houver
# um domínio.
#
# Necessário para verificação de e-mail no cadastro e recuperação de senha.
# Sem esta variável, o app continua funcionando normalmente, mas nenhum
# e-mail é enviado de verdade (fica só registrado no log do servidor).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Remetente dos e-mails. Enquanto nenhum domínio estiver verificado no
# Resend, deixe como está abaixo (só funciona para enviar ao seu próprio
# e-mail de cadastro no Resend). Depois de verificar um domínio próprio,
# troque para algo como: IFSul Fórum <naoresponda@seudominio.com>
EMAIL_FROM="IFSul Fórum <onboarding@resend.dev>"
