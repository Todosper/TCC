<div class="auth-page">
  <div class="auth-box auth-box-center">
    <div class="auth-icon auth-icon-danger"><%- icon('lock', 26) %></div>
    <h1 class="auth-title"><%= typeof heading !== 'undefined' ? heading : 'Acesso negado' %></h1>
    <p class="auth-sub auth-sub-spaced"><%= typeof message !== 'undefined' ? message : 'Você não tem permissão para acessar esta área.' %></p>
    <a href="/" class="btn btn-primary">Voltar ao Início</a>
  </div>
</div>
