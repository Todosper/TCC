<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <% var v = (typeof assetVersion !== 'undefined') ? assetVersion : '1'; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Início' %> — Fórum / FAQ IFSul Bagé</title>
  <script>
    // Tema e preferências de acessibilidade são aplicados antes da primeira
    // renderização, para a página não "piscar" em outro visual.
    (function () {
      var d = document.documentElement;
      function get(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
      var theme = get("theme");
      var systemDark = !window.matchMedia || window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (theme === "dark" || (theme !== "light" && systemDark)) d.classList.add("dark");
      var size = parseInt(get("a11y-font-size"), 10);
      if (size >= 80 && size <= 150 && size !== 100) d.style.fontSize = size + "%";
      if (get("a11y-contrast") === "1") d.classList.add("a11y-contrast");
      if (get("a11y-links") === "1") d.classList.add("a11y-links");
      if (get("a11y-libras-visible") === "0") d.classList.add("a11y-libras-hidden");
    })();
  </script>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <%# As fontes carregam sem bloquear a primeira renderização (media="print" + onload);
      com display=swap o texto aparece na fonte padrão e troca quando a fonte chega. %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap"></noscript>
  <link rel="stylesheet" href="/css/main.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/navbar.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/home.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/forms.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/forum.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/faq.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/suggestions.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/accessibility.css?v=<%= v %>">
</head>

<body>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <%- include('partials/navbar') %>
  <%- include('partials/accessibility-panel') %>
  <main id="conteudo" tabindex="-1">
    <%- body %>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/main.js?v=<%= v %>"></script>
  <script src="/js/accessibility.js?v=<%= v %>"></script>
  <script>
    // VLibras (tradutor de Libras do governo federal). O script só é baixado
    // depois que a página terminou de carregar, para que o site não dependa do
    // servidor do VLibras para responder. Se o botão de Libras estiver
    // escondido nas preferências, o script nem é baixado; ele é carregado se a
    // pessoa voltar a mostrar o botão (accessibility.js chama loadVLibras).
    (function () {
      var state = null; // "loading" | "ready"
      function fail() {
        state = null;
        document.dispatchEvent(new CustomEvent("vlibras:error"));
      }
      window.loadVLibras = function () {
        if (state) return;
        state = "loading";
        var s = document.createElement("script");
        s.src = "https://vlibras.gov.br/app/vlibras-plugin.js";
        s.async = true;
        s.onload = function () {
          try { new window.VLibras.Widget("https://vlibras.gov.br/app"); state = "ready"; } catch (e) { fail(); }
        };
        s.onerror = fail;
        document.body.appendChild(s);
      };
      function start() {
        if (!document.documentElement.classList.contains("a11y-libras-hidden")) window.loadVLibras();
      }
      if (document.readyState === "complete") start();
      else window.addEventListener("load", start);
    })();
  </script>
</body>

</html>
