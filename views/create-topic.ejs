<% var hasErrors = !!(errors.title || errors.category || errors.body); %>
<div class="container-md page-pad">
  <div class="auth-header-row">
    <a href="/forum" class="auth-back-btn" aria-label="Voltar ao fórum" title="Voltar ao fórum"><%- icon('arrowLeft', 16) %></a>
    <div>
      <h1>Criar Novo Tópico</h1>
      <p>Compartilhe uma dúvida ou informação com a comunidade</p>
    </div>
  </div>

  <div class="notice-box">
    <%- icon('alertCircle', 16) %>
    <p>O conteúdo deve ser relacionado ao ambiente escolar e acadêmico do IFSul Bagé. Tópicos fora do tema poderão ser removidos pela moderação.</p>
  </div>

  <% if (errors.general) { %>
    <div class="auth-error" tabindex="-1" data-autofocus-error><%- icon('alertCircle', 16) %><%= errors.general %></div>
  <% } else if (hasErrors) { %>
    <div class="auth-error" tabindex="-1" data-autofocus-error><%- icon('alertCircle', 16) %>Corrija os campos indicados abaixo e publique novamente.</div>
  <% } %>

  <form method="POST" action="/forum/novo" class="card card-pad-lg create-form-card">
    <%- include('partials/csrf-field') %>
    <div class="field">
      <label for="topic-title">Título do tópico</label>
      <input class="input <%= errors.title ? 'error' : '' %>" name="title" id="topic-title" required maxlength="120"
        placeholder="Descreva sua dúvida em poucas palavras" value="<%= form.title || '' %>" data-char-count="title-count" data-max="120"
        aria-describedby="title-count<%= errors.title ? ' title-error' : '' %>"<%- errors.title ? ' aria-invalid="true"' : '' %>>
      <p class="field-hint" id="title-count">0/120 caracteres</p>
      <% if (errors.title) { %><p class="field-error" id="title-error"><%- icon('alertCircle', 12) %><%= errors.title %></p><% } %>
    </div>
    <div class="field">
      <label for="topic-category">Categoria</label>
      <select class="input <%= errors.category ? 'error' : '' %>" name="category" id="topic-category" required
        <%- errors.category ? 'aria-invalid="true" aria-describedby="category-error"' : '' %>>
        <option value="">Selecione...</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= form.category === c.id ? 'selected' : '' %>><%= c.label %></option>
        <% }) %>
      </select>
      <% if (errors.category) { %><p class="field-error" id="category-error"><%- icon('alertCircle', 12) %><%= errors.category %></p><% } %>
    </div>
    <div class="field">
      <label for="topic-body">Descrição / Conteúdo</label>
      <textarea class="input <%= errors.body ? 'error' : '' %>" name="body" id="topic-body" rows="8" required maxlength="5000"
        placeholder="Descreva detalhadamente sua dúvida ou o assunto que deseja discutir..." data-char-count="body-count" data-max="5000"
        aria-describedby="body-count<%= errors.body ? ' body-error' : '' %>"<%- errors.body ? ' aria-invalid="true"' : '' %>><%= form.body || '' %></textarea>
      <p class="field-hint" id="body-count">0/5000 caracteres</p>
      <% if (errors.body) { %><p class="field-error" id="body-error"><%- icon('alertCircle', 12) %><%= errors.body %></p><% } %>
    </div>

    <div class="flex gap-3">
      <button type="submit" class="btn btn-primary btn-lg"><%- icon('send', 16) %>Publicar Tópico</button>
      <a href="/forum" class="btn btn-outline">Cancelar</a>
    </div>
  </form>
</div>
