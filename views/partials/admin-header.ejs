<div class="container admin-page">
  <div class="admin-header">
    <div class="admin-header-left">
      <div class="admin-header-icon"><%- icon('shield', 20) %></div>
      <div>
        <h1>Painel Administrativo</h1>
        <p>IFSul Fórum / FAQ — Campus Bagé</p>
      </div>
    </div>
    <a href="/" class="admin-back-link"><%- icon('arrowLeft', 16) %><span>Voltar ao site</span></a>
  </div>

  <% var adminTabs = [
    { id: 'dashboard', href: '/admin', icon: 'layoutDashboard', label: 'Dashboard' },
    { id: 'faq', href: '/admin/faq', icon: 'helpCircle', label: 'Gerenciar FAQ' },
    { id: 'forum', href: '/admin/forum', icon: 'messageSquare', label: 'Moderar Fórum' },
    { id: 'suggestions', href: '/admin/sugestoes', icon: 'lightbulb', label: 'Sugestões' },
    { id: 'held', href: '/admin/retidos', icon: 'shield', label: 'Em análise' },
    { id: 'reports', href: '/admin/denuncias', icon: 'flag', label: 'Denúncias' },
    { id: 'users', href: '/admin/users', icon: 'users', label: 'Usuários' },
    { id: 'log', href: '/admin/historico', icon: 'clock', label: 'Histórico' }
  ]; %>
  <nav class="tabs admin-tabs" aria-label="Seções do painel">
    <% adminTabs.forEach(function (t) { %>
      <a href="<%= t.href %>" class="tab-btn <%= tab === t.id ? 'active' : '' %>"<%- tab === t.id ? ' aria-current="page"' : '' %>><%- icon(t.icon, 16) %><%= t.label %></a>
    <% }) %>
  </nav>
