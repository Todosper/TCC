<% var hideFooter = false; %>
<div class="container admin-page">
  <div class="admin-header">
    <div class="admin-header-left">
      <div class="admin-header-icon"><%- icon('shield', 20) %></div>
      <div>
        <h1>Painel Administrativo</h1>
        <p>IFSul Fórum / FAQ — Campus Bagé</p>
      </div>
    </div>
    <a href="/" class="admin-back-link"><%- icon('arrowLeft', 16) %><span>Voltar ao site</span></a>
  </div>

  <div class="tabs admin-tabs">
    <a href="/admin" class="tab-btn <%= tab === 'dashboard' ? 'active' : '' %>"><%- icon('layoutDashboard', 16) %>Dashboard</a>
    <a href="/admin/faq" class="tab-btn <%= tab === 'faq' ? 'active' : '' %>"><%- icon('helpCircle', 16) %>Gerenciar FAQ</a>
    <a href="/admin/forum" class="tab-btn <%= tab === 'forum' ? 'active' : '' %>"><%- icon('messageSquare', 16) %>Moderar Fórum</a>
    <a href="/admin/sugestoes" class="tab-btn <%= tab === 'suggestions' ? 'active' : '' %>"><%- icon('lightbulb', 16) %>Sugestões</a>
    <a href="/admin/users" class="tab-btn <%= tab === 'users' ? 'active' : '' %>"><%- icon('users', 16) %>Usuários</a>
  </div>
