<div class="auth-page">
  <div class="auth-box">
    <div class="auth-card">
      <% if (status === 'success') { %>
        <div class="auth-success-block">
          <div class="auth-success-icon"><%- icon('checkCircle2', 28) %></div>
          <h2>E-mail confirmado!</h2>
          <p>Sua conta está totalmente ativa. Obrigado por confirmar.</p>
          <a href="/" class="btn btn-primary btn-block">Ir para o início</a>
        </div>
      <% } else { %>
        <div class="auth-header">
          <div class="auth-icon"><%- icon('alertCircle', 28) %></div>
          <h1 class="auth-title">Link inválido ou expirado</h1>
          <p class="auth-sub">Este link de confirmação não é mais válido. Ele pode já ter sido usado ou ter expirado (24 horas).</p>
        </div>
        <a href="/reenviar-verificacao" class="btn btn-primary btn-block">Pedir novo link</a>
        <a href="/login" class="btn btn-ghost btn-block" style="text-align:center;margin-top:0.5rem;">Voltar ao login</a>
      <% } %>
    </div>
  </div>
</div>
