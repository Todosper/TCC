<% var activePage = 'suggestions'; %>
<div class="container-sm suggestions-page">
  <div class="suggestions-hero">
    <div>
      <h1>Sugestões para o Campus</h1>
      <p>Envie propostas de melhoria para o IFSul Bagé e apoie as ideias que considera importantes. Esta área não possui comentários.</p>
    </div>
    <% if (loggedIn) { %>
      <a href="/sugestoes/nova" class="btn btn-primary btn-lg"><%- icon('lightbulb', 16) %>Enviar sugestão</a>
    <% } else { %>
      <a href="/login" class="btn btn-secondary">Entre para sugerir</a>
    <% } %>
  </div>

  <% if (typeof submitted !== 'undefined' && submitted) { %>
    <div class="auth-success"><%- icon('checkCircle2', 16) %>Recebemos sua sugestão! Ela será publicada após a aprovação da administração.</div>
  <% } %>

  <% if (suggestions.length === 0) { %>
    <div class="card suggestion-empty">
      <%- icon('lightbulb', 48) %>
      <h3>Ainda não há sugestões publicadas</h3>
      <p>As propostas aprovadas pela administração aparecerão aqui.</p>
      <% if (loggedIn) { %><a href="/sugestoes/nova" class="btn btn-primary">Enviar a primeira sugestão</a><% } %>
    </div>
  <% } else { %>
    <div class="suggestions-list">
      <% suggestions.forEach(function(s) { %>
        <article class="suggestion-card">
          <div class="suggestion-card-head">
            <h2><%= s.title %></h2>
            <span class="suggestion-status <%= s.status %>">
              <%= s.status === 'analysis' ? '🟡 Em análise' : s.status === 'planned' ? '🔵 Planejada' : s.status === 'implemented' ? '🟢 Implementada' : '🔴 Não será implementada' %>
            </span>
          </div>
          <p class="suggestion-description"><%= s.description %></p>
          <% if (s.status === 'not_implemented' && s.statusReason) { %>
            <p class="status-reason"><strong>Justificativa:</strong> <%= s.statusReason %></p>
          <% } %>
          <div class="suggestion-actions">
            <div class="suggestion-meta">
              <span><%- icon('user', 13) %> <%= s.isAnonymous ? 'Anônimo' : s.authorName %></span>
              <span><%- icon('calendar', 13) %> <%= (s.publishedAt || s.createdAt).toLocaleDateString('pt-BR') %></span>
            </div>
            <div class="flex items-center gap-2">
              <span class="support-count"><%= s.supportCount %> <%= s.supportCount === 1 ? 'apoio' : 'apoios' %></span>
              <% if (loggedIn) { %>
                <form method="POST" action="/sugestoes/<%= s._id %>/apoio">
                  <button class="support-button <%= s.hasSupported ? 'supported' : '' %>" type="submit" title="<%= s.hasSupported ? 'Remover apoio' : 'Apoiar sugestão' %>">
                    <%- icon('thumbsUp', 15) %><%= s.hasSupported ? 'Apoiando' : 'Apoiar' %>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>
