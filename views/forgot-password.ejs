<div class="auth-page">
  <div class="auth-box">
    <div class="auth-card">
      <div class="auth-header-row">
        <a href="/login" class="auth-back-btn" aria-label="Voltar para o login" title="Voltar para o login"><%- icon('arrowLeft', 16) %></a>
        <div>
          <h1>Recuperar Senha</h1>
          <p>Enviaremos um link para seu e-mail</p>
        </div>
      </div>

      <% if (sent) { %>
        <div class="auth-success-block" role="status">
          <div class="auth-success-icon"><%- icon('mail', 28) %></div>
          <h2>E-mail enviado!</h2>
          <p>Se o e-mail informado estiver cadastrado, você receberá em instantes um link para redefinir a senha. Confira também o spam.</p>
          <a href="/login">Voltar ao login</a>
        </div>
      <% } else { %>
        <% if (error) { %>
          <div class="auth-error" tabindex="-1" data-autofocus-error><%- icon('alertCircle', 16) %><%= error %></div>
        <% } %>
        <form class="auth-form" method="POST" action="/forgot-password">
          <%- include('partials/csrf-field') %>
          <p class="auth-instruction">
            Informe o e-mail cadastrado na sua conta. Você receberá um link para redefinir sua senha.
          </p>
          <div class="field">
            <label for="rec-email">E-mail</label>
            <input class="input" id="rec-email" name="email" type="email" autocomplete="email" required placeholder="nome@academico.ifsul.edu.br">
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block">
            <%- icon('send', 16) %>
            Enviar Link de Redefinição
          </button>
          <a href="/login" class="btn btn-ghost btn-block btn-centered">Voltar ao login</a>
        </form>
      <% } %>
    </div>
  </div>
</div>
