<%- include('../partials/admin-header') %>

  <div class="admin-table-toolbar">
    <h2>Usuários (<%= users.length %>)</h2>
    <form class="admin-search-box" method="GET" action="/admin/users">
      <%- icon('search', 16) %>
        <input type="text" name="q" value="<%= query %>" placeholder="Buscar por nome ou e-mail..."
          onchange="this.form.submit()">
    </form>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Usuário</th>
          <th class="md-table-cell">Perfil</th>
          <th class="sm-table-cell">Status</th>
          <th class="right">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td>
              <div class="table-user-cell">
                <div class="table-user-avatar"><%- icon('user', 14) %></div>
                <div>
                  <div class="table-user-name">
                    <%= u.name %>
                      <%= u.isAdmin ? ' ★' : '' %>
                  </div>
                  <div class="table-user-email">
                    <%= u.email %>
                  </div>
                </div>
              </div>
            </td>
            <td class="md-table-cell">
              <form method="POST" action="/admin/users/<%= u._id %>/role" class="admin-role-form">
                <%- include('../partials/csrf-field') %>
                <select class="admin-role-select" name="role" onchange="this.form.submit()" title="Alterar perfil">
                  <option value="estudante" <%= u.role === 'estudante' ? 'selected' : '' %>>Estudante</option>
                  <option value="professor" <%= u.role === 'professor' ? 'selected' : '' %>>Professor(a)</option>
                  <option value="staff" <%= u.role === 'staff' ? 'selected' : '' %>>Servidor(a) / Staff</option>
                </select>
              </form>
            </td>
            <td class="sm-table-cell">
              <span class="status-pill <%= u.status === 'ativo' ? 'active' : 'blocked' %>">
                <span class="dot"></span>
                <%= u.status==='ativo' ? 'Ativo' : 'Bloqueado' %>
              </span>
            </td>
            <td class="right">
              <div class="table-actions">
                    <!-- Toggle admin -->
                    <form method="POST" action="/admin/users/<%= u._id %>/toggle-admin" style="display:inline;">
                      <%- include('../partials/csrf-field') %>
                      <button type="submit" class="table-icon-btn <%= u.isAdmin ? 'ok' : '' %>" title="<%= u.isAdmin ? 'Remover admin' : 'Tornar admin' %>">
                        <%- icon('star', 14) %>
                      </button>
                    </form>
                    <!-- Toggle status -->
                    <form method="POST" action="/admin/users/<%= u._id %>/toggle-status" style="display:inline;">
                      <%- include('../partials/csrf-field') %>
                      <button type="submit" class="table-icon-btn <%= u.status === 'ativo' ? 'warn' : 'ok' %>">
                        <%- u.status==='ativo' ? icon('lock', 14) : icon('unlock', 14) %>
                      </button>
                    </form>
                    <!-- Excluir -->
                    <form method="POST" action="/admin/users/<%= u._id %>/excluir"
                      onsubmit="return confirm('Excluir este usuário? O nome e e-mail dele serão apagados, mas os tópicos, comentários e sugestões publicados permanecerão no sistema como de um \'Usuário removido\'. Esta ação não pode ser desfeita.');" style="display:inline;">
                      <%- include('../partials/csrf-field') %>
                      <button type="submit" class="table-icon-btn danger"><%- icon('trash2', 14) %></button>
                    </form>
              </div>
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>
  </div>

  <div class="admin-footnote">
    ★ = Administrador
  </div>

  <%- include('../partials/pagination') %>

  <%- include('../partials/admin-footer') %>