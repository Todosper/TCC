<%- include('../partials/admin-header') %>

<% var editing = !!(faq && faq._id); %>
<div class="auth-header-row">
  <a href="/admin/faq" class="auth-back-btn" aria-label="Voltar para a lista de perguntas" title="Voltar para a lista de perguntas"><%- icon('arrowLeft', 16) %></a>
  <div>
    <h2 class="admin-form-title"><%= editing ? 'Editar Pergunta' : 'Nova Pergunta' %></h2>
  </div>
</div>

<% if (errors.question || errors.answer || errors.category || errors.details) { %>
  <div class="auth-error" tabindex="-1" data-autofocus-error><%- icon('alertCircle', 16) %>Corrija os campos indicados abaixo e salve novamente.</div>
<% } %>

<form method="POST" action="<%= editing ? '/admin/faq/' + faq._id + '/editar' : '/admin/faq/novo' %>" class="admin-form-card">
  <%- include('../partials/csrf-field') %>
  <div class="field">
    <label for="faq-question">Pergunta</label>
    <input class="input <%= errors.question ? 'error' : '' %>" id="faq-question" name="question" value="<%= faq ? faq.question : '' %>" placeholder="Digite a pergunta" required
      <%- errors.question ? 'aria-invalid="true" aria-describedby="faq-question-error"' : '' %>>
    <% if (errors.question) { %><p class="field-error" id="faq-question-error"><%- icon('alertCircle', 12) %><%= errors.question %></p><% } %>
  </div>
  <div class="field">
    <label for="faq-category">Categoria</label>
    <select class="input <%= errors.category ? 'error' : '' %>" id="faq-category" name="category" required
      <%- errors.category ? 'aria-invalid="true" aria-describedby="faq-category-error"' : '' %>>
      <option value="">Selecione...</option>
      <% categories.forEach(function(c) { %>
        <% var selectedId = faq && faq.category ? (faq.category._id || faq.category).toString() : ''; %>
        <option value="<%= c._id %>" <%= selectedId === c._id.toString() ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
    <% if (errors.category) { %><p class="field-error" id="faq-category-error"><%- icon('alertCircle', 12) %><%= errors.category %></p><% } %>
  </div>
  <div class="field">
    <label for="faq-answer">Resposta</label>
    <textarea class="input <%= errors.answer ? 'error' : '' %>" id="faq-answer" name="answer" rows="6" placeholder="Digite a resposta" required
      <%- errors.answer ? 'aria-invalid="true" aria-describedby="faq-answer-error"' : '' %>><%= faq ? faq.answer : '' %></textarea>
    <p class="field-hint">Mantenha a resposta curta. Textos longos vão no campo abaixo.</p>
    <% if (errors.answer) { %><p class="field-error" id="faq-answer-error"><%- icon('alertCircle', 12) %><%= errors.answer %></p><% } %>
  </div>
  <div class="field">
    <label for="faq-details">Resposta completa <span class="text-gray-500">(opcional)</span></label>
    <textarea class="input <%= errors.details ? 'error' : '' %>" id="faq-details" name="details" rows="10" maxlength="10000" placeholder="Preencha só nos casos que precisam de uma página própria. Deixe uma linha em branco para separar parágrafos."
      <%- errors.details ? 'aria-invalid="true" aria-describedby="faq-details-error"' : '' %>><%= faq && faq.details ? faq.details : '' %></textarea>
    <p class="field-hint">Se preenchida, a pergunta ganha uma página própria e a resposta curta passa a ter o link “Ler resposta completa”.</p>
    <% if (errors.details) { %><p class="field-error" id="faq-details-error"><%- icon('alertCircle', 12) %><%= errors.details %></p><% } %>
  </div>
  <div class="flex gap-3">
    <button type="submit" class="btn btn-primary"><%- icon('check', 16) %>Salvar</button>
    <a href="/admin/faq" class="btn btn-outline">Cancelar</a>
  </div>
</form>

<%- include('../partials/admin-footer') %>
