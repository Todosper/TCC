<%- include('../partials/admin-header') %>

<div class="admin-table-toolbar">
  <h2>Perguntas Frequentes (<%= faqs.length %>)</h2>
  <div class="toolbar-actions">
    <a href="/admin/faq-categorias" class="btn btn-outline btn-sm"><%- icon('edit', 16) %>Categorias</a>
    <a href="/admin/faq/novo" class="btn btn-primary btn-sm"><%- icon('plus', 16) %>Nova Pergunta</a>
  </div>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th class="col-wide">Pergunta</th>
        <th class="sm-table-cell">Categoria</th>
        <th class="right">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% faqs.forEach(function(f) { %>
        <tr>
          <td><span class="line-clamp-1 admin-table-title"><%= f.question %></span></td>
          <td class="sm-table-cell"><span class="text-xs text-gray-500"><%= f.category ? f.category.name : '-' %></span></td>
          <td class="right">
            <div class="table-actions">
              <a href="/admin/faq/<%= f._id %>/editar" class="table-icon-btn edit" title="Editar pergunta" aria-label="Editar pergunta: <%= f.question %>"><%- icon('edit', 14) %></a>
              <form method="POST" action="/admin/faq/<%= f._id %>/excluir" data-confirm="Excluir esta pergunta?" class="inline-form">
                <%- include('../partials/csrf-field') %>
                <button type="submit" class="table-icon-btn danger" title="Excluir pergunta" aria-label="Excluir pergunta: <%= f.question %>"><%- icon('trash2', 14) %></button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin-footer') %>
