<%- include('../partials/admin-header') %>

<div class="admin-table-toolbar">
  <h2>Moderação do Fórum (<%= total %> <%= plural(total, 'tópico', 'tópicos') %>)</h2>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Tópico</th>
        <th class="md-table-cell">Autor</th>
        <th class="sm-table-cell">Status</th>
        <th class="right">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% topics.forEach(function(t) { %>
        <tr>
          <td>
            <a href="/forum/topico/<%= t._id %>" class="line-clamp-1 admin-table-title"><%= t.title %></a>
            <span class="badge <%= catCls(t.category) %> badge-spaced"><%= catLabel(t.category) %></span>
          </td>
          <td class="md-table-cell"><span class="text-xs text-gray-500"><%= t.authorName %></span></td>
          <td class="sm-table-cell">
            <% if (t.locked) { %>
              <span class="status-text locked"><%- icon('lock', 12) %>Encerrado</span>
            <% } else { %>
              <span class="status-text active"><%- icon('checkCircle2', 12) %>Ativo</span>
            <% } %>
          </td>
          <td class="right">
            <div class="table-actions">
              <form method="POST" action="/admin/forum/<%= t._id %>/toggle-lock" class="inline-form">
                <%- include('../partials/csrf-field') %>
                <button type="submit" class="table-icon-btn <%= t.locked ? 'ok' : 'warn' %>"
                  title="<%= t.locked ? 'Reabrir tópico' : 'Encerrar tópico' %>" aria-label="<%= t.locked ? 'Reabrir' : 'Encerrar' %> o tópico: <%= t.title %>">
                  <%- t.locked ? icon('unlock', 14) : icon('lock', 14) %>
                </button>
              </form>
              <form method="POST" action="/admin/forum/<%= t._id %>/excluir" data-confirm="Excluir este tópico e todas as respostas?" class="inline-form">
                <%- include('../partials/csrf-field') %>
                <button type="submit" class="table-icon-btn danger" title="Excluir tópico" aria-label="Excluir o tópico: <%= t.title %>"><%- icon('trash2', 14) %></button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/pagination') %>

<%- include('../partials/admin-footer') %>
