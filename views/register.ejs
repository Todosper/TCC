<% var hasFieldErrors = !!(errors.name || errors.email || errors.password || errors.password2); %>
<div class="auth-page">
  <div class="auth-box wide">
    <div class="auth-card">
      <% if (done) { %>
        <div class="auth-success-block" role="status">
          <div class="auth-success-icon"><%- icon('checkCircle2', 28) %></div>
          <h1>Conta criada!</h1>
          <% if (locals.verifyEmail) { %>
            <p>Enviamos um link de confirmação para <strong><%= locals.verifyEmail %></strong>. Clique nele (confira também o spam) e depois entre com seu e-mail e senha.</p>
          <% } else { %>
            <p>Você já pode entrar normalmente com seu e-mail e senha.</p>
          <% } %>
          <a href="/login" class="btn btn-primary btn-block">Ir para o Login</a>
        </div>
      <% } else { %>
        <div class="auth-header-row">
          <a href="/login" class="auth-back-btn" aria-label="Voltar para o login" title="Voltar para o login"><%- icon('arrowLeft', 16) %></a>
          <div>
            <h1>Criar Conta</h1>
            <p>Preencha os dados para se cadastrar</p>
          </div>
        </div>

        <% if (errors.general) { %>
          <div class="auth-error" tabindex="-1" data-autofocus-error><%- icon('alertCircle', 16) %><%= errors.general %></div>
        <% } else if (hasFieldErrors) { %>
          <div class="auth-error" tabindex="-1" data-autofocus-error><%- icon('alertCircle', 16) %>Corrija os campos indicados abaixo e envie novamente.</div>
        <% } %>

        <% if (typeof googleEnabled !== 'undefined' && googleEnabled) { %>
          <%- include('partials/google-button', { href: '/auth/google', label: 'Criar conta com o Google' }) %>
          <p class="field-hint google-hint">Use a conta Google do seu e-mail do IFSul.</p>
          <div class="auth-divider"><span>ou preencha os dados</span></div>
        <% } %>

        <form class="auth-form-grid" method="POST" action="/register">
          <%- include('partials/csrf-field') %>
          <div class="field span-2">
            <label for="name">Nome completo</label>
            <input class="input <%= errors.name ? 'error' : '' %>" id="name" name="name" autocomplete="name" required maxlength="100"
              placeholder="Seu nome completo" value="<%= form.name || '' %>"
              <%- errors.name ? 'aria-invalid="true" aria-describedby="name-error"' : '' %>>
            <% if (errors.name) { %><p class="field-error" id="name-error"><%- icon('alertCircle', 12) %><%= errors.name %></p><% } %>
          </div>
          <div class="field span-2">
            <label for="email">E-mail acadêmico</label>
            <input class="input <%= errors.email ? 'error' : '' %>" id="email" name="email" type="email" autocomplete="email" required
              placeholder="nome@academico.ifsul.edu.br" value="<%= form.email || '' %>"
              aria-describedby="email-hint<%= errors.email ? ' email-error' : '' %>"<%- errors.email ? ' aria-invalid="true"' : '' %>>
            <p class="field-hint" id="email-hint">Use o e-mail do IFSul que termina em @academico.ifsul.edu.br.</p>
            <% if (errors.email) { %><p class="field-error" id="email-error"><%- icon('alertCircle', 12) %><%= errors.email %></p><% } %>
          </div>
          <div class="field">
            <label for="pwf">Senha</label>
            <div class="field-wrap">
              <input class="input has-right <%= errors.password ? 'error' : '' %>" id="pwf" name="password" type="password" autocomplete="new-password" required minlength="8"
                aria-describedby="pwf-hint<%= errors.password ? ' pwf-error' : '' %>"<%- errors.password ? ' aria-invalid="true"' : '' %>>
              <button type="button" class="field-right" data-toggle-password="pwf"><%- icon('eye', 16) %></button>
            </div>
            <div class="pw-strength" aria-hidden="true">
              <div class="pw-strength-bar"></div><div class="pw-strength-bar"></div>
              <div class="pw-strength-bar"></div><div class="pw-strength-bar"></div>
            </div>
            <p class="field-hint" id="pwf-hint">Mínimo de 8 caracteres. <span id="pw-strength-label" aria-live="polite"></span></p>
            <% if (errors.password) { %><p class="field-error" id="pwf-error"><%- icon('alertCircle', 12) %><%= errors.password %></p><% } %>
          </div>
          <div class="field">
            <label for="pw2">Confirmar senha</label>
            <input class="input <%= errors.password2 ? 'error' : '' %>" id="pw2" name="password2" type="password" autocomplete="new-password" required
              <%- errors.password2 ? 'aria-invalid="true" aria-describedby="pw2-error"' : '' %>>
            <% if (errors.password2) { %><p class="field-error" id="pw2-error"><%- icon('alertCircle', 12) %><%= errors.password2 %></p><% } %>
          </div>

          <div class="span-2 auth-submit-row">
            <button type="submit" class="btn btn-primary btn-lg btn-block">
              <%- icon('userPlus', 16) %>
              Criar Conta
            </button>
          </div>
        </form>
        <p class="auth-terms">Ao criar sua conta, você concorda com os <a href="/privacidade">termos de uso e a política de privacidade</a> do sistema.</p>
        <p class="auth-footer-text">Já tem conta? <a href="/login">Entrar</a></p>
      <% } %>
    </div>
  </div>
</div>
