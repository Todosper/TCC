<div class="auth-page">
  <div class="auth-box">
    <div class="auth-card">
      <% if (!valid) { %>
        <div class="auth-header">
          <div class="auth-icon"><%- icon('alertCircle', 28) %></div>
          <h1 class="auth-title">Link inválido ou expirado</h1>
          <p class="auth-sub">Este link de redefinição de senha não é mais válido. Ele pode já ter sido usado ou ter expirado (1 hora).</p>
        </div>
        <a href="/forgot-password" class="btn btn-primary btn-block">Pedir novo link</a>
        <a href="/login" class="btn btn-ghost btn-block" style="text-align:center;margin-top:0.5rem;">Voltar ao login</a>
      <% } else { %>
        <div class="auth-header">
          <div class="auth-icon"><%- icon('graduationCap', 28) %></div>
          <h1 class="auth-title">Redefinir senha</h1>
          <p class="auth-sub">Escolha uma nova senha para sua conta</p>
        </div>

        <% if (error) { %>
          <div class="auth-error"><%- icon('alertCircle', 16) %><%= error %></div>
        <% } %>

        <form class="auth-form" method="POST" action="/redefinir-senha">
          <%- include('partials/csrf-field') %>
          <input type="hidden" name="token" value="<%= token %>">
          <input type="hidden" name="id" value="<%= id %>">
          <div class="field">
            <label for="pw">Nova senha</label>
            <div class="field-wrap">
              <input class="input has-right" id="pw" name="password" type="password" placeholder="Ao menos 8 caracteres" minlength="8" required>
              <button type="button" class="field-right" data-toggle-password="pw">
                <%- icon('eye', 16) %>
              </button>
            </div>
          </div>
          <div class="field">
            <label for="pw2">Confirme a nova senha</label>
            <input class="input" id="pw2" name="password2" type="password" placeholder="Repita a senha" minlength="8" required>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block">Redefinir senha</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
